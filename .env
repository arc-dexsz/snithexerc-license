# Local development (SQLite). Do not use a local SQLite file in Vercel production.
DATABASE_PATH=./data/app.db

# Production database (Turso / libSQL)
# Create a database in Turso, then fill these values in Vercel Project Settings.
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# Initial admin account. These values are seeded only when the database is first initialized.
ADMIN_USER=admin
ADMIN_PASS=admin

# Optional: secure values are generated and stored in the database if omitted.
# API_TOKEN=replace-with-a-long-random-api-token
# SESSION_SECRET=replace-with-a-long-random-session-secret
